 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "# Free GPU Coding-LLM Server on Kaggle (2x T4)\n\nHosts a strong open coding model on Kaggle's free **2x Tesla T4 (16GB + 16GB)** GPUs using **vLLM**, and exposes an **OpenAI-compatible API** over a free Cloudflare tunnel — so you can point Cline / Continue / aider / any OpenAI-compatible tool at it from your own machine.\n\n## Before you run\n1. **Settings (right sidebar):** Accelerator = `GPU T4 x2`, Internet = `On`, Persistence = `No persistence`.\n2. Run all cells top to bottom. The tunnel URL is printed by the **TUNNEL** cell.\n3. Kaggle gives ~30 GPU hours/week and kills sessions after ~9–12h. Re-run when it dies — you get a new URL each time.\n\n## Honest performance expectations\n- T4 is a 2018 GPU: no bfloat16, no FlashAttention-2, no Marlin quant kernels. We run `--dtype half`.\n- Do NOT use quantized MoE models (e.g. Qwen3-Coder-30B-A3B-AWQ) on T4 — measured ~1 tok/s. Dense models only.\n- Single request: expect roughly **15–30 tok/s** with the dense 14B, more with the 7B.\n- **Higher total throughput** comes from **parallel requests** (vLLM continuous batching), not one stream."
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": "# ============ CONFIG — auto-picks the best model for your GPU ============\nimport torch\n\nFORCE_MODEL = None   # set a HF repo id here to override auto-selection, e.g. \"Qwen/Qwen2.5-Coder-7B-Instruct-AWQ\"\n\nNUM_GPUS = torch.cuda.device_count()\ncap = torch.cuda.get_device_capability(0)\nSM = cap[0] * 10 + cap[1]                      # 75 = T4, 80+ = Ampere or newer\nVRAM_TOTAL = sum(torch.cuda.get_device_properties(i).total_memory for i in range(NUM_GPUS)) / 1e9\nGPU_NAME = torch.cuda.get_device_name(0)\n\n# Tensor parallel must divide the model's attention heads — 1, 2 or 4 are safe.\nTP_SIZE = NUM_GPUS if NUM_GPUS in (1, 2, 4) else 2\n\nif FORCE_MODEL:\n    MODEL_ID = FORCE_MODEL\nelif SM >= 80:\n    # Ampere+ (A100, L4, RTX 3090/4090, L40S, H100): Marlin kernels available,\n    # so the quantized MoE coder runs FAST here — best quality per token/s.\n    if VRAM_TOTAL >= 22:\n        MODEL_ID = \"cpatonn/Qwen3-Coder-30B-A3B-Instruct-AWQ\"   # ~17GB weights\n    elif VRAM_TOTAL >= 14:\n        MODEL_ID = \"Qwen/Qwen2.5-Coder-14B-Instruct-AWQ\"\n    else:\n        MODEL_ID = \"Qwen/Qwen2.5-Coder-7B-Instruct-AWQ\"\nelif SM >= 75:\n    # Turing (T4, RTX 20-series): AWQ works for DENSE models only.\n    # Quantized MoE falls back to a ~1 tok/s path here — never use it on T4.\n    if VRAM_TOTAL >= 24:\n        MODEL_ID = \"Qwen/Qwen2.5-Coder-14B-Instruct-AWQ\"        # Kaggle 2x T4 lands here\n    elif VRAM_TOTAL >= 12:\n        MODEL_ID = \"Qwen/Qwen2.5-Coder-7B-Instruct-AWQ\"\n    else:\n        MODEL_ID = \"Qwen/Qwen2.5-Coder-3B-Instruct\"\nelse:\n    # Pascal/Volta (P100 etc.): no AWQ support — unquantized fp16 only.\n    MODEL_ID = \"Qwen/Qwen2.5-Coder-7B-Instruct\" if VRAM_TOTAL >= 15 else \"Qwen/Qwen2.5-Coder-3B-Instruct\"\n\nMAX_MODEL_LEN = 32768 if VRAM_TOTAL >= 24 else 16384   # lower it further if you hit KV-cache OOM\nSERVED_NAME = \"coder\"                                   # the model name clients will use\n\nprint(f\"GPU: {NUM_GPUS}x {GPU_NAME} (SM{SM}, {VRAM_TOTAL:.0f}GB total)\")\nprint(f\"Model: {MODEL_ID}  |  TP={TP_SIZE}  |  ctx={MAX_MODEL_LEN}\")"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============ INSTALL (takes a few minutes) ============\n",
    "%pip install -q -U vllm huggingface_hub\n",
    "\n",
    "# cloudflared binary for the free quick tunnel (no account needed)\n",
    "!wget -q -O /tmp/cloudflared https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64\n",
    "!chmod +x /tmp/cloudflared\n",
    "print(\"install done\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": "# ============ START vLLM SERVER (background) ============\nimport subprocess, time, urllib.request, os\n\ncmd = [\n    \"python\", \"-m\", \"vllm.entrypoints.openai.api_server\",\n    \"--model\", MODEL_ID,\n    \"--served-model-name\", SERVED_NAME,\n    \"--tensor-parallel-size\", str(TP_SIZE),\n    \"--dtype\", \"half\",                  # works everywhere incl. pre-Ampere GPUs (no bf16 there)\n    \"--max-model-len\", str(MAX_MODEL_LEN),\n    \"--gpu-memory-utilization\", \"0.90\",\n    \"--host\", \"0.0.0.0\", \"--port\", \"8000\",\n    \"--api-key\", \"kaggle-local-key\",    # simple auth so random people can't use your GPU\n    # CUDA graphs stay ON (big decode speedup). If you OOM during startup,\n    # add \"--enforce-eager\" here or lower MAX_MODEL_LEN.\n]\nlog = open(\"/kaggle/working/vllm.log\" if os.path.isdir(\"/kaggle/working\") else \"vllm.log\", \"w\")\nserver = subprocess.Popen(cmd, stdout=log, stderr=subprocess.STDOUT)\nLOG_PATH = log.name\nprint(\"vLLM starting (model download + load can take 5-15 min on first run)...\")\n\n# wait until the server answers\nfor i in range(240):\n    try:\n        urllib.request.urlopen(\"http://127.0.0.1:8000/health\", timeout=2)\n        print(\"vLLM is UP\")\n        break\n    except Exception:\n        if server.poll() is not None:\n            print(\"SERVER DIED — last 40 log lines:\")\n            os.system(f\"tail -40 {LOG_PATH}\")\n            raise SystemExit(\"vLLM failed to start. Lower MAX_MODEL_LEN, add --enforce-eager, or set FORCE_MODEL to a smaller model.\")\n        time.sleep(5)\nelse:\n    raise SystemExit(f\"Timed out waiting for vLLM. Check {LOG_PATH}\")"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============ TUNNEL — prints your public URL ============\n",
    "import subprocess, re, time\n",
    "\n",
    "tun = subprocess.Popen(\n",
    "    [\"/tmp/cloudflared\", \"tunnel\", \"--url\", \"http://127.0.0.1:8000\", \"--no-autoupdate\"],\n",
    "    stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,\n",
    ")\n",
    "public_url = None\n",
    "start = time.time()\n",
    "while time.time() - start < 60:\n",
    "    line = tun.stdout.readline()\n",
    "    m = re.search(r\"https://[a-z0-9-]+\\.trycloudflare\\.com\", line or \"\")\n",
    "    if m:\n",
    "        public_url = m.group(0)\n",
    "        break\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(\"OPENAI-COMPATIBLE BASE URL:\", (public_url or \"NOT FOUND — rerun this cell\") + \"/v1\")\n",
    "print(\"API KEY: kaggle-local-key\")\n",
    "print(\"MODEL NAME:\", SERVED_NAME)\n",
    "print(\"=\" * 60)"
   ]
  },
  {
